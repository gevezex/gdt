{
  "name": "@gevezex/gdt",
  "version": "0.3.1",
  "description": "GitHub issues to merge-ready pull requests, with a developer, tester and reviewer agent.",
  "keywords": [
    "github",
    "pull-request",
    "ai-agents",
    "coding-agent",
    "claude-code",
    "codex",
    "opencode",
    "cli"
  ],
  "license": "MIT",
  "author": "Ayhan Cicek",
  "homepage": "https://github.com/gevezex/gdt#readme",
  "bugs": {
    "url": "https://github.com/gevezex/gdt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gevezex/gdt.git"
  },
  "type": "module",
  "bin": {
    "gdt": "dist/cli.js"
  },
  "files": [
    "dist",
    "locales",
    "roles",
    "schemas",
    "skill"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/export-schemas.js",
    "lint": "eslint . && tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm test"
  },
  "dependencies": {
    "smol-toml": "^1.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
